##########################################
### 결제 API (/api/payments)
##########################################

@baseUrl = http://localhost:8080
@contentType = application/json
@idempotencyKey = {{$uuid}}
@paymentKey = 5EnNZRJGvaBX7zk2yd8ydw26XvwXkLrx9POLqKQjmAw4b0e1
@conflictingPaymentKey = conflicting-payment-key

### 1. 결제 준비
### 주문 생성 API 응답의 orderId를 사용합니다.
### 같은 요청을 재전송할 때는 동일한 idempotencyKey를 사용합니다.
POST {{baseUrl}}/api/payments/prepare
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}
Idempotency-Key: {{idempotencyKey}}

{
  "orderId": "{{orderId}}"
}

> {%
    const paymentId = response.body.data.paymentId;
    const paymentAttemptId = response.body.data.paymentAttemptId;
    const orderId = response.body.data.orderId;
    const amount = response.body.data.amount;

    if (paymentId && paymentAttemptId && orderId && amount) {
        client.global.set("paymentId", paymentId);
        client.global.set("paymentAttemptId", paymentAttemptId);
        client.global.set("orderId", orderId);
        client.global.set("amount", amount);
        client.log("Payment ID saved: " + paymentId + ", Payment Attempt ID saved: " + paymentAttemptId + ", Order ID: " + orderId + ", Amount: " + amount);
    } else {
        client.log("Error: paymentId, paymentAttemptId, orderId or amount not found in prepare response.");
    }
%}

### 2. 결제 승인
### 같은 승인 요청을 재전송할 때는 paymentId, paymentAttemptId, orderId, paymentKey, amount를 동일하게 사용합니다.
POST {{baseUrl}}/api/payments/confirm
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "paymentId": "{{paymentId}}",
  "paymentAttemptId": "{{paymentAttemptId}}",
  "orderId": "{{orderId}}",
  "paymentKey": "{{paymentKey}}",
  "amount": {{amount}}
}

### 2-1. 동일 승인 요청 재전송
### 최초 승인과 동일하게 성공하지만 PaymentCompletedEvent는 다시 발행하지 않습니다.
POST {{baseUrl}}/api/payments/confirm
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "paymentId": "{{paymentId}}",
  "paymentAttemptId": "{{paymentAttemptId}}",
  "orderId": "{{orderId}}",
  "paymentKey": "{{paymentKey}}",
  "amount": {{amount}}
}

### 2-2. 승인된 Payment에 다른 paymentKey 사용
### 기존 승인 정보와 다르므로 409 Conflict를 반환합니다.
POST {{baseUrl}}/api/payments/confirm
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "paymentId": "{{paymentId}}",
  "paymentAttemptId": "{{paymentAttemptId}}",
  "orderId": "{{orderId}}",
  "paymentKey": "{{conflictingPaymentKey}}",
  "amount": {{amount}}
}
