##########################################
### 결제 API (/api/payments)
##########################################

@baseUrl = http://localhost:8080
@contentType = application/json

### 1. 결제 준비
### 주문 생성 API 응답의 orderId를 사용합니다.
POST {{baseUrl}}/api/payments/prepare
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "orderId": "{{orderId}}"
}

> {%
    const paymentId = response.body.data.paymentId;
    const orderId = response.body.data.orderId;
    const amount = response.body.data.amount;

    if (paymentId && orderId && amount) {
        client.global.set("paymentId", paymentId);
        client.global.set("orderId", orderId);
        client.global.set("amount", amount);
        client.log("Payment ID saved: " + paymentId + ", Order ID: " + orderId + ", Amount: " + amount);
    } else {
        client.log("Error: paymentId, orderId or amount not found in prepare response.");
    }
%}

### 2. 결제 완료
POST {{baseUrl}}/api/payments/confirm
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "paymentId": "{{paymentId}}",
  "orderId": "{{orderId}}",
  "paymentKey": "5EnNZRJGvaBX7zk2yd8ydw26XvwXkLrx9POLqKQjmAw4b0e1",
  "amount": {{amount}}
}
